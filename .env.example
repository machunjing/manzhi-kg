# 复制为 backend/.env 后填入你自己的值；.env 已被 .gitignore 忽略，不会进版本库
# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here

# ---- Neo4j（可选，图谱查询目前走 MySQL）----
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ---- 大模型（可选，不填则问答回退为「图谱事实 + 原文证据」模板）----
# 智谱开放平台 https://open.bigmodel.cn 申请，格式为 id.secret
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TIMEOUT=45
